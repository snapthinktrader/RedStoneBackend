# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=redstone_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_very_long_and_secure
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# Crypto Payment Gateway (Example: CoinPayments)
COINPAYMENTS_API_KEY=your_coinpayments_api_key
COINPAYMENTS_SECRET=your_coinpayments_secret
COINPAYMENTS_WEBHOOK_SECRET=your_webhook_secret

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Admin Configuration
ADMIN_EMAIL=admin@redstone.com
ADMIN_PASSWORD=super_secure_admin_password

# Application Configuration
APP_NAME="RedStone"
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Referral Configuration
DAILY_EARNING_RATE=0.02
MIN_DEPOSIT_USD=50
MIN_WITHDRAWAL_USD=10

# Level Commission Rates (JSON format)
LEVEL_COMMISSION_RATES={"1":0.05,"2":0.08,"3":0.12,"4":0.15,"5":0.20}

# Milestone Bonuses (JSON format)
MILESTONE_BONUSES={"10":100,"25":300,"50":750,"100":2000,"200":5000}

# Cloud Storage (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis Configuration (Optional for caching)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log